# Copy to .env.local and fill in.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key: server-only, never prefix it with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin
ADMIN_PASSWORD=

# Telegram bot
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=royalsalmon_bot
# Chat or group that receives customer complaints (optional)
TELEGRAM_STAFF_CHAT_ID=

# Public HTTPS address of the site (Telegram buttons, courier links)
NEXT_PUBLIC_SITE_URL=https://royalsalmon.ge

# Map tiles (optional)
NEXT_PUBLIC_CARTO_BASEMAPS_KEY=

# Road routing; the public OSRM demo server is used when unset
OSRM_URL=
